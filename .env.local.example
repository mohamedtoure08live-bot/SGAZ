# =============================================================================
# SOSGAZ DOMESTIC • CONFIGURATION SUPABASE FULL STACK
# =============================================================================
# 1. Créez un projet sur https://supabase.com
# 2. Exécutez le script 'supabase/full_migration.sql' dans l'Éditeur SQL Supabase
# 3. Récupérez vos clés d'API dans Settings > API
# =============================================================================

# URL de votre projet Supabase (ex: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé anonyme publique (Anon Key) - sûre pour le navigateur
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Clé de rôle de service (Service Role Key) - STRICTEMENT PRIVÉE CÔTÉ SERVEUR
# Ne jamais préfixer par NEXT_PUBLIC !
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete

# Clé secrète pour la signature cryptographique des cookies de session admin
ADMIN_SESSION_SECRET=sosgaz_dev_super_secret_session_key_2026_abidjan_change_in_prod
